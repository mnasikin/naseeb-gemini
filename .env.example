# Express listens on port 3000 by default. Preview defaults to 4173.
# PORT=3000

# Production serves dist/ and requires HTTPS for the secure session cookie.
# NODE_ENV=production

# SQLite data defaults to .byok/ at the project root. Use a persistent path in production.
# BYOK_DATA_DIR=/path/to/persistent/naseeb-byok

# Optional. Generate with openssl rand -hex 32. Without this, the server creates
# gemini.key in the data directory. Keep the same encryption key across deploys.
# BYOK_ENCRYPTION_KEY=

# Optional. Set to true to disable Vite HMR and file watching.
# DISABLE_HMR=true
